# ============================================================
# MARKETBOOK ENVIRONMENT CONFIGURATION
# ============================================================

# Database (Default: SQLite for zero-configuration local dev; or Postgres url)
DATABASE_URL="file:./dev.db"

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Real-Time & Market Data API Providers
# (MarketBook operates seamlessly with built-in live WebSocket feeds like Binance, 
# and provides honest status indicators if external keys are omitted)
FINNHUB_API_KEY=""
COINGECKO_API_KEY=""
ALPHAVANTAGE_API_KEY=""
NEWS_API_KEY=""

# Web3 / Blockchain Network RPCs (Ethereum Mainnet / Sepolia)
NEXT_PUBLIC_ETHEREUM_RPC_URL="https://rpc.ankr.com/eth"
NEXT_PUBLIC_SEPOLIA_RPC_URL="https://rpc.ankr.com/eth_sepolia"

# Smart Contract Addresses (Deployed contracts on Sepolia or local testnet)
NEXT_PUBLIC_NFT_CONTRACT_ADDRESS="0x1234567890123456789012345678901234567890"
NEXT_PUBLIC_MARKETPLACE_CONTRACT_ADDRESS="0x0987654321098765432109876543210987654321"

# IPFS Pinata / Web3 Storage Credentials (for NFT minting wizard)
PINATA_API_KEY=""
PINATA_API_SECRET=""
PINATA_JWT=""

# Authentication & Session
NEXTAUTH_SECRET="marketbook-super-secret-key-change-in-production-123456"
SESSION_PASSWORD="complex_password_at_least_32_characters_long_cookie"
